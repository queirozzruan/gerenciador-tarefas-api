{
  "name": "gerenciador-tarefas-api",
  "version": "1.0.0",
  "description": "API RESTful de gerenciamento de tarefas com Clean Architecture",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "swagger": "node swagger.js",
    "dev": "npm run swagger && nodemon src/server.js",
    "test": "jest --runInBand",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
