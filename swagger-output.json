{
  "swagger": "2.0",
  "info": {
    "title": "API de Gerenciamento de Tarefas",
    "description": "API para criação e acompanhamento de usuários e suas tarefas.",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/health": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/usuarios": {
      "post": {
        "tags": [
          "Usuários"
        ],
        "description": "Cria um novo usuário.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CriarUsuario"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Usuário criado com sucesso."
          },
          "400": {
            "description": "Dados de entrada inválidos.",
            "schema": {
              "$ref": "#/definitions/ErroValidacao"
            }
          }
        }
      },
      "get": {
        "tags": [
          "Usuários"
        ],
        "description": "Lista todos os usuários cadastrados.",
        "responses": {
          "200": {
            "description": "Lista de usuários."
          }
        }
      }
    },
    "/tarefas": {
      "post": {
        "tags": [
          "Tarefas"
        ],
        "description": "Cria uma tarefa com status inicial PENDENTE.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "description": "Título, descrição opcional e ID do usuário responsável.",
            "schema": {
              "$ref": "#/definitions/CriarTarefa"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Tarefa criada com sucesso."
          },
          "400": {
            "description": "Dados de entrada inválidos.",
            "schema": {
              "$ref": "#/definitions/ErroValidacao"
            }
          },
          "404": {
            "description": "Usuário não encontrado."
          }
        }
      },
      "get": {
        "tags": [
          "Tarefas"
        ],
        "description": "Lista todas as tarefas cadastradas.",
        "responses": {
          "200": {
            "description": "Lista de tarefas."
          }
        }
      }
    },
    "/tarefas/{id}": {
      "put": {
        "tags": [
          "Tarefas"
        ],
        "description": "Atualiza o título de uma tarefa.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Tarefa atualizada com sucesso."
          },
          "404": {
            "description": "Tarefa não encontrada."
          }
        }
      },
      "delete": {
        "tags": [
          "Tarefas"
        ],
        "description": "Exclui uma tarefa.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "204": {
            "description": "Tarefa excluída com sucesso."
          },
          "404": {
            "description": "Tarefa não encontrada."
          }
        }
      }
    },
    "/tarefas/{id}/iniciar": {
      "post": {
        "tags": [
          "Tarefas"
        ],
        "description": "Inicia uma tarefa PENDENTE.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Tarefa iniciada com sucesso."
          },
          "400": {
            "description": "Retornado quando o usuário atinge o limite máximo de 5 tarefas com status EM_ANDAMENTO."
          },
          "404": {
            "description": "Tarefa não encontrada."
          }
        }
      }
    },
    "/tarefas/{id}/concluir": {
      "post": {
        "tags": [
          "Tarefas"
        ],
        "description": "Conclui uma tarefa EM_ANDAMENTO.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Tarefa concluída com sucesso."
          },
          "400": {
            "description": "Retornado quando a tarefa não está com status EM_ANDAMENTO."
          },
          "404": {
            "description": "Tarefa não encontrada."
          }
        }
      }
    }
  },
  "definitions": {
    "CriarUsuario": {
      "type": "object",
      "properties": {
        "nome": {
          "type": "string",
          "example": "Maria Silva"
        },
        "email": {
          "type": "string",
          "example": "maria@example.com"
        }
      }
    },
    "CriarTarefa": {
      "type": "object",
      "properties": {
        "titulo": {
          "type": "string",
          "example": "Estudar Swagger"
        },
        "descricao": {
          "type": "string",
          "example": "Documentar os endpoints da API."
        },
        "usuarioId": {
          "type": "number",
          "example": 1
        }
      }
    },
    "ErroValidacao": {
      "type": "object",
      "properties": {
        "erro": {
          "type": "string",
          "example": "Dados de entrada inválidos."
        },
        "campos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "campo": {
                "type": "string",
                "example": "nome"
              },
              "mensagem": {
                "type": "string",
                "example": "O nome deve ter pelo menos 3 caracteres."
              }
            }
          }
        }
      }
    }
  }
}